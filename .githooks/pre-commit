#!/usr/bin/env sh

# Format and vet, the first half of the gate in AGENTS.md. Both are seconds, so
# they run on every commit; the suite and its coverage floor run once per push
# in pre-push. There is no husky: this is a Go module, and git's core.hooksPath
# does the same job with no package.json (scripts/hooks.sh arms it). See
# doc/TESTING.md, "Git hooks".
#
# Skip flags (set to any non-empty value):
#   SKIP_FORMAT SKIP_LINT SKIP_AGENT_DOCS SKIP_ALL

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
RESET='\033[0m'

step() { printf "\n${CYAN}${BOLD}> %s${RESET}\n" "$1"; }
ok() { printf "${GREEN}[ok] %s${RESET}\n" "$1"; }
skip() { printf "${YELLOW}[skip] %s${RESET}\n" "$1"; }
fail() { printf "${RED}[fail] %s${RESET}\n" "$1"; }

if [ -n "$SKIP_ALL" ]; then
	printf "${YELLOW}${BOLD}pre-commit: SKIP_ALL set - skipping every check${RESET}\n"
	exit 0
fi

printf "${BOLD}pre-commit: running checks${RESET}\n"
printf "${DIM}  skip flags: SKIP_FORMAT SKIP_LINT SKIP_AGENT_DOCS SKIP_ALL${RESET}\n"

# The working tree, not the index: vet works on packages, and a package is not
# something the index alone can build. Commit what you checked.
if [ -n "$SKIP_FORMAT" ]; then
	skip "format"
else
	step "format (gofmt)"
	# gofmt -l exits 0 whether or not it lists anything, so the list is the
	# verdict: an empty one passes.
	unformatted=$(gofmt -l .)
	if [ -n "$unformatted" ]; then
		printf "%s\n" "$unformatted"
		fail "format failed: run gofmt -w ."
		exit 1
	fi
	ok "format passed"
fi

if [ -n "$SKIP_LINT" ]; then
	skip "vet"
else
	step "vet"
	if ! go vet ./...; then
		fail "go vet failed"
		exit 1
	fi
	ok "vet passed"
fi

# Agent instruction files have hard size limits (32 KB a file for Codex, 150 KB in
# total for Claude Code; "Instruction files stay small" in ~/AGENTS.md). The checker
# lives in the dotfiles, so a machine without them skips rather than fails.
if [ -n "$SKIP_AGENT_DOCS" ]; then
	skip "agent instruction file budget"
elif command -v agent-docs-budget >/dev/null 2>&1; then
	step "agent instruction file budget"
	if ! agent-docs-budget --check .; then
		fail "an agent instruction file is over budget"
		exit 1
	fi
	ok "instruction files within budget"
else
	skip "agent-docs-budget not installed"
fi

printf "\n${GREEN}${BOLD}[ok] pre-commit checks passed${RESET}\n"
